<Project Sdk="Microsoft.NET.Sdk">
  <!-- No test touches the network or a GPU. VL.Core is referenced WITHOUT ExcludeAssets here:
       a test host is not vvvv and supplies nothing. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>VL.Globe.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="VL.Core" Version="2025.7.4" />
    <!-- Stride's build step writes a module initializer into THIS assembly that loads Stride.Engine;
         without the runtime assets every test dies in <Module>.cctor before its first line. -->
    <PackageReference Include="VL.Stride.Runtime" Version="2025.7.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\VL.Globe\VL.Globe.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- ROADMAP 4b: pixelmatch's own test images and the render-test manifest -->
    <None Include="MapLibre\pixelmatch-fixtures\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="MapLibre\render-tests.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="MapLibre\render-tests-gpu.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="MapLibre\shaping\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
