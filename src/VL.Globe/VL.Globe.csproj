<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>VL.Globe</AssemblyName>
    <RootNamespace>VL.Globe</RootNamespace>
    <Version>0.0.1</Version>
    <Authors>VL.Globe Contributors</Authors>
    <Description>Web Mercator tiles on a globe in vvvv gamma's Stride</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Every NuGet dependency next to the built assembly; see vl-mapsui's csproj for the silent
         greyed-out-node failure this prevents. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ship inside vvvv 7.4: compile against them, never copy them. -->
    <PackageReference Include="VL.Core" Version="2025.7.4" ExcludeAssets="runtime" />
    <!-- VLGame (the graphics device) and, transitively, Stride 4.2.1.2487 - the version vvvv 7.4 ships. -->
    <PackageReference Include="VL.Stride.Runtime" Version="2025.7.4" ExcludeAssets="runtime" />
    <!-- SkiaSharp: the draped path (Engine\Draped) and the attribution; vvvv ships it (2.88.8), as VL.Mapsui references it -->
    <PackageReference Include="VL.Core.Skia" Version="2025.7.4" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same version as VL.NetTopologySuite and VL.Mapsui: one identity in one vvvv process. -->
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <!-- FeatureLayer takes NTS Features, VL.NetTopologySuite's Feature type; VL.Mapsui's version -->
    <PackageReference Include="NetTopologySuite.Features" Version="2.1.0" />
    <!-- VL.Mapsui's version, deliberately: both packages load into one vvvv process, and NuGet
         unifies to one BruTile. Move them together or not at all. -->
    <PackageReference Include="BruTile" Version="5.0.6" />
  </ItemGroup>
</Project>
