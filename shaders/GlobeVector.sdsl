// VL.Globe's vector tiles on the GPU (docs/DESIGN-GPU-VECTOR.md), drawn by Engine/VectorRenderer.cs.
// GL JS's line and fill shaders on a globe: a line vertex is extruded here, in pixels at its own
// depth, so a line keeps its width on screen at every zoom; its edge is antialiased in the pixel
// shader with GL JS's ramp, alpha = clamp(outset * (1 - |N|)), outset = half width + 0.5 px.
shader GlobeVector : ShaderBase
{
    // Each draw's own values, one element a draw in a buffer written once a frame; a draw finds its own
    // by its index, a per-instance vertex attribute (D3D11 offsets those by the draw's start instance,
    // not SV_InstanceID). One Apply a pass instead of one a draw (ROADMAP 4g, 2026-11-23: at 4000-6000
    // draws zoomed out, setting and applying each draw's parameters was 5 ms of a missed frame).
    struct GvDraw
    {
        float4x4 WorldView;     // scale (radius) and the tile's camera-relative translation, then the view
        float4 Color;           // linear, straight alpha; times the vertex colour
        float4 Clip;            // u0 v0 u1 v1 in the tile's square: the rest is discarded
        float4 TileTrig;        // the tile centre's sin and cos of latitude, sin and cos of longitude (TileProjection.Geo)
        float4 CentreHalfWidth; // the tile's centre on the unit sphere (for the tangent frame); half the width, px (0: a fill)
        float4 Misc;            // the tile centre's Mercator y (radians), tiles per side (2^z), is a line, -
    };

    rgroup PerDraw.GvDraws
    {
        stage StructuredBuffer<GvDraw> GvDraws;
    }

    cbuffer PerDraw
    {
        stage float4x4 GvProjection;
        stage float GvRadius;
        stage float GvPixel;            // view units per pixel at depth 1: 2 / (projection._22 * viewport height)
        stage float GvLift;             // fraction of the distance moved towards the eye, over the tiles
        stage float GvStraight;         // 1: straight colour out, for the hardware-antialiased line list
        stage float GvExtrusion;        // 1: fill-extrusion, lit; GvColor is sRGB then
        stage float GvLinearize;        // 1: vvvv (sRGB colours into a linear pipeline); 0: as GL JS, all in sRGB (the render tests)
        stage float GvFlat;             // 1: on the Mercator plane (x east, y north, z up), not the sphere
        stage float GvGlOutline;        // 1: the line list as GL JS's fill_outline: aliased, alpha 1 - smoothstep(distance)
        stage float2 GvViewport;        // the target's size in pixels
        stage float2 GvFade;            // fill-extrusion fades out between these distances from the eye (y 0: never)
    }

    stage stream float GvDrawIn : TEXCOORD4;     // per instance: the draw's index in GvDraws (a float: exact to 2^24)
    stage stream float GvDrawId;                 // to the pixel shader: the same for the whole draw, rounded there

    stage stream uint2 GvUvIn : TEXCOORD1;       // the place in the tile: (uv + 0.5) x 32768
    stage stream int4 GvExtrude : TEXCOORD0;     // GL JS's extrusion bytes in .xy: e = k / 63
    stage stream float2 GvEdgeIn : TEXCOORD2;    // N; the feature's width scale, or for fill-extrusion the metres raised
    stage stream float4 GvColorIn : COLOR0;

    stage stream float2 GvUv;
    stage stream float GvEdge;
    stage stream float GvOutset;
    stage stream float4 GvTint;
    stage stream float2 GvScreen;   // GL JS's v_pos: the vertex in pixels, interpolated along the line

    float3 ToLinear(float3 c)
    {
        if (GvLinearize < 0.5) return c;
        c = saturate(c);
        return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);
    }

    // The place in the tile (uv, v down) to the position relative to the tile's centre, raised by
    // metres: Engine/TileProjection.cs, whose RelativeFloat is this arithmetic in C# (tested there).
    // Only small quantities are subtracted - floats keep a z14 tile to well under a millimetre.
    // Small arguments by polynomial: the GPU's sin and atan are exact to ~1e-6 ABSOLUTE, a quarter of a
    // percent of a z14 tile's 4e-4 radians - metres. Adds and multiplies are exact to float's rounding.
    float SinS(float x) { float q = x * x; return abs(x) < 0.25 ? x * (1 - q / 6 * (1 - q / 20 * (1 - q / 42 * (1 - q / 72)))) : sin(x); }
    float CosS(float x) { float q = x * x; return abs(x) < 0.25 ? 1 - q / 2 * (1 - q / 12 * (1 - q / 30 * (1 - q / 56))) : cos(x); }
    float SinhS(float x) { float q = x * x; return abs(x) < 0.25 ? x * (1 + q / 6 * (1 + q / 20 * (1 + q / 42 * (1 + q / 72)))) : sinh(x); }
    float AtanS(float t)
    {
        float q = t * t;
        return abs(t) < 0.25 ? t * (1 - q * (1.0 / 3 - q * (1.0 / 5 - q * (1.0 / 7 - q * (1.0 / 9 - q * (1.0 / 11 - q / 13)))))) : atan(t);
    }

    float3 Relative(GvDraw dr, float2 uv, float raise)
    {
        float GvTiles = dr.Misc.y, GvTileMercatorY = dr.Misc.x;
        float4 GvTileTrig = dr.TileTrig;
        float delta = 6.283185307 / GvTiles;
        float du = uv.x - 0.5, dv = uv.y - 0.5;
        float d = -dv * delta;   // Mercator y grows north, v south
        // a buffer past the Mercator square (z0-z2) held at its edge, as the builder clamped it; only
        // then, so the small d is never formed again as a difference of large values
        if (GvFlat < 0.5 && abs(GvTileMercatorY + d) > 3.141592654) d = sign(GvTileMercatorY + d) * 3.141592654 - GvTileMercatorY;
        if (GvFlat > 0.5)
            return float3(du / GvTiles, -dv / GvTiles, raise * cosh(GvTileMercatorY + d) / (6.283185307 * 6378137.0));
        float sinLatC = GvTileTrig.x, cosLatC = GvTileTrig.y, sinLonC = GvTileTrig.z, cosLonC = GvTileTrig.w;
        float dLat = 2 * AtanS(SinhS(d / 2) / cosh(GvTileMercatorY + d / 2));
        float sh = SinS(dLat / 2), ch = CosS(dLat / 2);
        float sinMid = sinLatC * ch + cosLatC * sh, cosMid = cosLatC * ch - sinLatC * sh;
        float cosLat = cosLatC * CosS(dLat) - sinLatC * SinS(dLat);
        float dSinLat = 2 * cosMid * sh, dCosLat = -2 * sinMid * sh;
        float dLon = du * delta;
        float s = SinS(dLon / 2), oneMinusCos = 2 * s * s, sinDLon = SinS(dLon);
        float a = dCosLat - cosLat * oneMinusCos;   // cos(lat) cos(dLon) - cos(latC)
        float3 rel = float3(sinLonC * a + cosLat * cosLonC * sinDLon, dSinLat, cosLonC * a - cosLat * sinLonC * sinDLon);
        if (raise != 0)
        {
            float3 centre = float3(cosLatC * sinLonC, sinLatC, cosLatC * cosLonC);
            rel += (centre + rel) * (raise / 6378137.0);
        }
        return rel;
    }

    // the vertex's up, east and north: on the sphere from its direction, on the plane fixed
    void Frame(GvDraw dr, float3 position, out float3 up, out float3 east, out float3 north)
    {
        if (GvFlat > 0.5) { up = float3(0, 0, 1); east = float3(1, 0, 0); north = float3(0, 1, 0); return; }
        up = normalize(dr.CentreHalfWidth.xyz + position);
        east = normalize(float3(up.z, 0, -up.x));
        north = cross(up, east);
    }

    stage override void VSMain()
    {
        GvDraw dr = GvDraws[(uint)streams.GvDrawIn];
        streams.GvDrawId = streams.GvDrawIn;
        float4x4 GvWorldView = dr.WorldView;
        float4 GvColor = dr.Color;
        float GvTiles = dr.Misc.y, GvHalfWidth = dr.CentreHalfWidth.w, GvIsLine = dr.Misc.z;
        float2 uvIn = float2(streams.GvUvIn) / 32768.0 - 0.5;
        float3 position = Relative(dr, uvIn, GvExtrusion > 0.5 ? streams.GvEdgeIn.y : 0);
        float4 v = mul(float4(position, 1), GvWorldView);
        float outset = 0;
        float2 uvShift = 0;
        if (GvIsLine > 0.5)
        {
            float3 p, east, north;
            Frame(dr, position, p, east, north);
            float2 q = float2(streams.GvExtrude.xy) / 63.0;
            float3 dir = q.x * east - q.y * north;
            float3 dirView = mul(float4(dir, 0), GvWorldView).xyz / GvRadius;
            outset = GvHalfWidth * streams.GvEdgeIn.y + 0.5;
            float depth = max(-v.z, 1e-9);
            float reach = outset * GvPixel * depth;   // view units = scene units: the extrusion's length per unit of q
            v.xyz += dirView * reach;
            // the extruded point's place in the tile, not the line's: GL JS clips each tile's drawing to
            // its square by the stencil, so a line's edge past the square is cut there and the
            // neighbour's copy (from its buffer) draws the rest. Clipped by the line's own point, line
            // ends and corners at tile edges came out differently (MapLibre's fixtures, 2026-11-22).
            float span = GvFlat > 0.5 ? 1 / GvTiles : 6.283185307 * sqrt(saturate(1 - p.y * p.y)) / GvTiles;
            uvShift = q * (reach / GvRadius / span);
        }
        v.xyz *= (1 - GvLift);
        streams.ShadingPosition = mul(v, GvProjection);
        // in pixels, y down as SV_Position is (GL JS's v_pos, y up as gl_FragCoord is)
        float2 ndc = streams.ShadingPosition.xy / streams.ShadingPosition.w;
        streams.GvScreen = float2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5) * GvViewport;
        streams.GvUv = uvIn + uvShift;
        streams.GvEdge = streams.GvEdgeIn.x;
        streams.GvOutset = outset;
        if (GvExtrusion > 0.5)
        {
            // GL JS's fill_extrusion.vertex.glsl with its default light: anchored to the viewport at
            // [1.15, 210, 30] (radial, azimuthal, polar) = (0.2875, -0.498, 0.996) in the map's
            // east / south / up; intensity 0.5, colour white, 0.03 ambient. In sRGB, as GL JS.
            float3 p, east, north;
            Frame(dr, position, p, east, north);
            float2 e = float2(streams.GvExtrude.xy);
            float3 n = dot(e, e) > 0 ? normalize(e.x * east - e.y * north) : p;
            float3 light = 0.2875 * east + 0.498 * north + 0.996 * p;
            float4 color = streams.GvColorIn * GvColor;
            float value = dot(color.rgb, float3(0.2126, 0.7152, 0.0722));
            float3 rgb = color.rgb + 0.03;
            float directional = saturate(dot(n, light));
            directional = lerp(0.5, max(1.5 - value, 1.0), directional);
            directional *= streams.GvEdgeIn.x;   // the wall's vertical gradient; 1 on a roof
            rgb = saturate(rgb * directional);
            // Mapbox's fill-extrusion-cutoff-fade-range: out before the tiles fall to a zoom without heights
            float fade = GvFade.y > 0 ? 1 - smoothstep(GvFade.x, GvFade.y, length(v.xyz)) : 1;
            streams.GvTint = float4(ToLinear(rgb), color.a * fade);
            streams.GvEdge = 0;
        }
        else streams.GvTint = float4(ToLinear(streams.GvColorIn.rgb), streams.GvColorIn.a) * GvColor;
    }

    stage override void PSMain()
    {
        GvDraw dr = GvDraws[(uint)round(streams.GvDrawId)];
        float4 GvClip = dr.Clip;
        float GvIsLine = dr.Misc.z;
        float2 uv = streams.GvUv;
        if (uv.x < GvClip.x || uv.y < GvClip.y || uv.x > GvClip.z || uv.y > GvClip.w) discard;
        float alpha = streams.GvTint.a;
        if (GvIsLine > 0.5) alpha *= saturate(streams.GvOutset * (1 - abs(streams.GvEdge)));
        if (GvGlOutline > 0.5) alpha *= 1 - smoothstep(0, 1, length(streams.GvScreen - streams.ShadingPosition.xy));
        streams.ColorTarget = GvStraight > 0.5 ? float4(streams.GvTint.rgb, alpha) : float4(streams.GvTint.rgb * alpha, alpha);
    }
};
