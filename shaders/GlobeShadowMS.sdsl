// GlobeShadowBase reading a multisampled depth (vvvv's window): every sample, so that an outline
// keeps its antialiasing (GlobeShadowBase.PSMain).
shader GlobeShadowMS : GlobeShadowBase
{
    stage Texture2DMS<float> GhSceneDepth;

    float DepthAt(int2 pixel, int sample) { return GhSceneDepth.Load(pixel, sample); }

    int Samples()
    {
        uint width, height, samples;
        GhSceneDepth.GetDimensions(width, height, samples);
        return (int)samples;
    }
};
