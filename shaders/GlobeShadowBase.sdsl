// VL.Globe's cast shadows (ROADMAP 6b, C), the receiving half, drawn by Engine/Gpu/ShadowPass.cs: one
// full-screen triangle after the buildings, before the labels. Each pixel's position is found from the
// depth the buildings were drawn on (the scene's depth and the buildings' own: the ground, the user's
// models, the buildings), carried into the sun's shadow maps and compared there; a pixel in shadow is
// darkened by multiplying what is drawn (the blend state multiplies the target by this colour).
// Two cascades: the near map out to a split, the far one beyond, blended over the split's last tenth.
// GlobeShadow reads a single-sampled depth, GlobeShadowMS a multisampled one (vvvv's window): only
// DepthAt differs.
shader GlobeShadowBase : ShaderBase
{
    cbuffer PerDraw
    {
        stage float4 GhProjection;          // the camera's projection: M11, M22, M31, M32 (a pixel to a direction)
        stage float2 GhDepth;               // its M33, M43: depth to view-space z
        stage float4x4 GhViewToShadow0;     // view space to the near map's clip space
        stage float4x4 GhViewToShadow1;     // ... and to the far map's
        stage float2 GhViewport;            // the target's size in pixels
        stage float GhTexel;                // one shadow-map texel, in its uv
        stage float2 GhBias;                // depth bias per map, in its depth units
        stage float2 GhOffset;              // per map: how far a point is moved along its normal before the lookup, view units
        stage float2 GhSplit;               // the view distances over which the near map hands over to the far one
        stage float GhStrength;             // 0: no shadow, 1: black
        stage float2 GhFade;                // the view distance where the shadow begins to fade and where it is gone
        stage float3 GhLightView;           // towards the light, in view space
        stage int GhSamples;                // the scene depth's samples per pixel: 1, or 2, 4, 8 multisampled
        stage float2 GhAo;                  // PROTOTYPE (docs/DESIGN-EFFECTS.md): screen-space ambient occlusion - strength (0: off), radius in view units
    }

    stage Texture2D<float> GhShadowMap0;
    stage Texture2D<float> GhShadowMap1;

    stage stream float2 GhPositionIn : POSITION;   // a full-screen triangle, in clip space
    stage stream float2 GhClip;

    abstract float DepthAt(int2 pixel, int sample);

    stage override void VSMain()
    {
        streams.ShadingPosition = float4(streams.GhPositionIn, 0, 1);
        streams.GhClip = streams.GhPositionIn;
    }

    // how much of the sun a point sees in map c: 3 x 3 texels, each compared (PCF without a comparison
    // sampler); -1 when the point is outside that map
    float Lit(int c, float3 view, float3 n)
    {
        float4x4 m = c == 0 ? GhViewToShadow0 : GhViewToShadow1;
        float4 s = mul(float4(view + n * (c == 0 ? GhOffset.x : GhOffset.y), 1), m);
        float2 uv = float2(s.x * 0.5 + 0.5, 0.5 - s.y * 0.5);
        if (any(uv < 0) || any(uv > 1) || s.z < 0 || s.z > 1) return -1;
        float depth = s.z - (c == 0 ? GhBias.x : GhBias.y);
        int size = (int)round(1 / GhTexel);
        int2 texel = int2(floor(uv * size));
        float lit = 0;
        [unroll] for (int y = -1; y <= 1; y++)
            [unroll] for (int x = -1; x <= 1; x++)
            {
                int3 t = int3(clamp(texel + int2(x, y), 0, size - 1), 0);
                float stored = c == 0 ? GhShadowMap0.Load(t) : GhShadowMap1.Load(t);
                lit += depth <= stored ? 1 : 0;
            }
        return lit / 9;
    }

    // a pixel's place in view space from its depth and its direction - not through an inverted projection,
    // whose near plane at street level leaves nothing of a float inverse (GlobeFog)
    float3 ViewAt(int2 pixel, int sample)
    {
        float d = DepthAt(clamp(pixel, 0, int2(GhViewport) - 1), sample);
        float z = -GhDepth.y / (d + GhDepth.x);                 // clip.z = z M33 + M43, clip.w = -z
        float2 clip = float2((pixel.x + 0.5) / GhViewport.x * 2 - 1, 1 - (pixel.y + 0.5) / GhViewport.y * 2);
        float2 slope = (clip + GhProjection.zw) / GhProjection.xy;
        return float3(slope * -z, z);
    }

    // how much shadow one sample of a pixel is in: 0 none, 1 full
    float Shade(int2 pixel, int sample)
    {
        if (DepthAt(pixel, sample) >= 1) return 0;              // nothing drawn here: the sky
        float3 view = ViewAt(pixel, sample);
        // the surface's normal from the neighbouring pixels' positions, turned towards the eye: on each axis
        // the neighbour nearer in depth, so that along an outline the normal is the pixel's own face's, not
        // one across the edge (ddx/ddy left a seam of unshaded dots along every building). A face turned
        // away from the sun is already dark by its light (GlobeVector): it gets no shadow on top, and has
        // none of the stripes a face at a grazing angle to the light draws against its own depth (acne).
        float3 right = ViewAt(pixel + int2(1, 0), sample) - view, left = view - ViewAt(pixel - int2(1, 0), sample);
        float3 down = ViewAt(pixel + int2(0, 1), sample) - view, up = view - ViewAt(pixel - int2(0, 1), sample);
        float3 dx = abs(right.z) < abs(left.z) ? right : left;
        float3 dy = abs(down.z) < abs(up.z) ? down : up;
        float3 n = normalize(cross(dy, dx));
        if (dot(n, view) > 0) n = -n;
        if (dot(n, GhLightView) < 0.05) return 0;
        float distance = -view.z;
        float lit;
        float hand = smoothstep(GhSplit.x, GhSplit.y, distance);   // 0: the near map, 1: the far one
        float nearLit = hand < 1 ? Lit(0, view, n) : -1;
        float farLit = hand > 0 || nearLit < 0 ? Lit(1, view, n) : -1;
        if (nearLit < 0 && farLit < 0) return 0;
        if (nearLit < 0) lit = farLit;
        else if (farLit < 0) lit = nearLit;
        else lit = lerp(nearLit, farLit, hand);
        return (1 - lit) * (1 - smoothstep(GhFade.x, GhFade.y, distance));
    }

    // PROTOTYPE, for a picture to judge by (VLGLOBE_SSAO): Stride's AmbientOcclusionRawAOShader sampler - a spiral
    // of taps on the depth round the pixel, each occluding by how far it stands above the pixel's surface - in
    // our units, without its blur. 0 open, 1 fully occluded.
    float Occlusion(int2 pixel)
    {
        if (DepthAt(pixel, 0) >= 1) return 0;
        float3 view = ViewAt(pixel, 0);
        float3 right = ViewAt(pixel + int2(1, 0), 0) - view, left = view - ViewAt(pixel - int2(1, 0), 0);
        float3 down = ViewAt(pixel + int2(0, 1), 0) - view, up = view - ViewAt(pixel - int2(0, 1), 0);
        float3 dx = abs(right.z) < abs(left.z) ? right : left;
        float3 dy = abs(down.z) < abs(up.z) ? down : up;
        float3 n = normalize(cross(dy, dx));
        if (dot(n, view) > 0) n = -n;
        float radius = GhAo.y;
        // the radius on the screen, in pixels, at this depth
        float disk = min(radius * GhProjection.y / -view.z * GhViewport.y * 0.5, 96);
        if (disk < 1.5) return 0;
        float turn = 0;   // no rotation per pixel: without the blur it is a hatching
        float sum = 0;
        const int taps = 24;
        [loop] for (int i = 0; i < taps; i++)
        {
            float a = (i + 0.5) / taps;
            float angle = a * 43.9822971503 + turn;
            int2 at = pixel + int2(round(float2(cos(angle), sin(angle)) * a * disk));
            if (any(at < 0) || any(at >= int2(GhViewport))) continue;
            if (DepthAt(at, 0) >= 1) continue;
            float3 v = ViewAt(at, 0) - view;
            float d2 = dot(v, v);
            float f = max(radius * radius - d2, 0);
            // (times the radius: Stride's term is 1 / length, of the order of 1 only where the radius is 1)
            sum += f * f * f * max((dot(v, n) - 0.12 * radius) * radius / (1e-4 * radius * radius + d2), 0);
        }
        float r3 = radius * radius * radius;
        return saturate(sum / (r3 * r3) * 5 / taps);
    }

    stage override void PSMain()
    {
        int2 pixel = int2(streams.ShadingPosition.xy);
        // inside a surface every sample has the pixel's depth: shaded once. On an outline (a multisampled
        // target, a building's edge against the ground) each sample is shaded and the pixel gets their
        // mean - shaded once from the first sample, the outlines lost their antialiasing: a staircase.
        // (Stride 4.2's shader parser has no SV_SampleIndex, which would run this per sample. The count
        // comes from C#: Texture2DMS.GetDimensions, through Stride's translation, gave a wrong one - every
        // sample read past the last, walls black in vvvv and no shadow at all offscreen.)
        int count = GhSamples;
        float first = DepthAt(pixel, 0);
        bool outline = false;
        [loop] for (int s = 1; s < count; s++)
            if (abs(DepthAt(pixel, s) - first) > 1e-6) outline = true;
        float shade = 0;
        if (!outline) shade = Shade(pixel, 0);
        else
        {
            [loop] for (int s = 0; s < count; s++) shade += Shade(pixel, s);
            shade /= count;
        }
        float occluded = GhAo.x > 0 ? GhAo.x * Occlusion(pixel) : 0;
        if (shade < 0.002 && occluded < 0.002) discard;
        float k = (1 - GhStrength * shade) * (1 - occluded);
        streams.ColorTarget = float4(k, k, k, 1);
    }
};
