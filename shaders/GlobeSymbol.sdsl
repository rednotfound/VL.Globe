// VL.Globe's labels (ROADMAP 4e), drawn by Engine/VectorRenderer.cs: GL JS's symbol_sdf shaders for
// point labels in the viewport (text-pitch-alignment and text-rotation-alignment viewport, GL JS's
// defaults for point placement). The anchor is projected from its place on the globe (or the
// Mercator plane, in MapLibre's render tests); each glyph's quad is laid out in screen pixels from
// there, so text stays upright and its size on screen fixed. Antialiasing and the halo as
// symbol_sdf.fragment.glsl: smoothstep on the signed-distance field. Icons (milestone 4) as
// symbol_icon.*.glsl - the image atlas's premultiplied colour times the opacity - or, for an SDF
// icon, as text with the field in the alpha channel and the font scale the icon-size itself.
shader GlobeSymbol : ShaderBase
{
    cbuffer PerDraw
    {
        stage float4x4 GsWorldView;     // the tile's camera-relative translation (and scale), then the view
        stage float4x4 GsProjection;
        stage float3 GsCentre;          // the tile's centre on the unit sphere (its up)
        stage float2 GsViewport;        // the target in pixels
        stage float2 GsTexSize;         // the atlas in pixels
        stage float4 GsColor;           // text-color, premultiplied; times the vertex colour
        stage float4 GsHaloColor;       // text-halo-color, premultiplied
        stage float GsSize;             // text-size in px, when it does not depend on the feature
        stage float GsSizeFromVertex;   // 1: the size is per vertex
        stage float GsOpacity;          // text-opacity when it does not depend on the feature (else 1)
        stage float GsFadeChange;       // GL JS's u_fade_change: the time since the placement's commit, in fades
        stage float GsHaloWidth;
        stage float GsHaloBlur;
        stage float GsIsHalo;           // GL JS's u_is_halo and u_is_plain
        stage float GsIsPlain;
        stage float GsCameraToCenter;   // the distance from the eye to the view's centre, for GL JS's perspective ratio
        stage float GsLift;
        stage float GsFlat;             // 1: on the Mercator plane (no far side to hide)
        stage float GsLinearize;        // 1: vvvv's linear pipeline; 0: sRGB, as GL JS
        stage float GsDevicePixelRatio;
        stage float GsIconMode;         // 0 text, 1 an icon (RGBA), 2 an SDF icon
        stage float GsNearest;          // 1: GL JS's gl.NEAREST for icons drawn at their own size
    }

    stage Texture2D GsAtlas;
    stage SamplerState GsSampler
    {
        Filter = MIN_MAG_MIP_LINEAR;
        AddressU = Clamp;
        AddressV = Clamp;
    };
    stage SamplerState GsPointSampler
    {
        Filter = MIN_MAG_MIP_POINT;
        AddressU = Clamp;
        AddressV = Clamp;
    };

    stage stream float3 GsAnchor : POSITION;      // on the unit sphere (or the plane), relative to the tile's centre
    stage stream int4 GsOffsetTex : TEXCOORD0;    // xy: the corner's offset x 32 at 24 px (GL JS's a_offset); zw: the atlas pixel
    stage stream float2 GsSizeOpacity : TEXCOORD1; // the feature's size and opacity where they depend on it
    stage stream float4 GsColorIn : COLOR0;       // the feature's colour (sRGB, straight) where it depends on it, else white
    stage stream float GsPlacedIn : TEXCOORD2;    // slot 1: the fade state - placed: 1 + opacity, not: -opacity (LabelFades.Pack)
    stage stream float4 GsLineIn : TEXCOORD3;     // slot 2: a glyph along a line - x, y px, angle, 1; -1 hidden; 0 a point label
    stage stream int4 GsPixelIn : TEXCOORD4;      // a stretchable icon: xy pixels x 16 not stretched, zw the min font scale x 256

    stage stream float2 GsTex;
    stage stream float3 GsData;                   // GL JS's v_data1: gamma scale, size, opacity
    stage stream float4 GsFill;

    float3 ToLinear(float3 c)
    {
        if (GsLinearize < 0.5) return c;
        c = saturate(c);
        return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);
    }

    stage override void VSMain()
    {
        float4 v = mul(float4(streams.GsAnchor, 1), GsWorldView);
        v.xyz *= (1 - GsLift);
        float4 clip = mul(v, GsProjection);
        // not drawn (moved out of clip space, as GL JS does): an anchor whose up looks away from the
        // eye - the far side of the globe - or a label all but transparent. Stride's VSMain must not
        // return early (X3080), so a flag
        bool hidden = false;
        if (GsFlat < 0.5)
        {
            float3 up = mul(float4(normalize(GsCentre + streams.GsAnchor), 0), GsWorldView).xyz;
            hidden = dot(up, -v.xyz) <= 0;
        }
        float opacity = streams.GsSizeOpacity.y * GsOpacity;
        // GL JS: the opacity at the commit, moved towards placed or not by the time since
        float state = streams.GsPlacedIn;
        float fade = state > 0.5 ? saturate(state - 1 + GsFadeChange) : saturate(-state - GsFadeChange);
        hidden = hidden || opacity < 0.1 || fade <= 0;
        opacity *= fade;
        float size = GsSizeFromVertex > 0.5 ? streams.GsSizeOpacity.x : GsSize;
        // GL JS: labels in the viewport are scaled by 0.5 + 0.5 x (camera to centre / camera to anchor)
        float perspective = clamp(0.5 + 0.5 * GsCameraToCenter / max(clip.w, 1e-9), 0, 4);
        size *= perspective;
        float fontScale = GsIconMode > 0.5 ? size : size / 24.0;
        // GL JS: a_offset / 32 * max(a_minFontScale, fontScale) + a_pxoffset / 16
        float2 offset = float2(streams.GsOffsetTex.xy) / 32.0 * max(float2(streams.GsPixelIn.zw) / 256.0, fontScale)
            + float2(streams.GsPixelIn.xy) / 16.0;
        if (streams.GsLineIn.w > 0.5)
        {
            // along a line: the glyph's place in pixels, the quad turned to its segment (GL JS's
            // a_projected_pos and segment_angle; rotation_matrix turns by the angle, y down)
            float s = sin(streams.GsLineIn.z), c = cos(streams.GsLineIn.z);
            // CSS pixels (as placed), to the target's device pixels
            float2 px = (streams.GsLineIn.xy + float2(c * offset.x - s * offset.y, s * offset.x + c * offset.y)) * GsDevicePixelRatio;
            clip = float4(px.x / GsViewport.x * 2 - 1, 1 - px.y / GsViewport.y * 2, saturate(clip.z / clip.w), 1);
        }
        else
            // pixels, y down, to clip space at the anchor's depth
            clip.xy += float2(2 * offset.x / GsViewport.x, -2 * offset.y / GsViewport.y) * GsDevicePixelRatio * clip.w;
        hidden = hidden || streams.GsLineIn.w < -0.5;
        streams.ShadingPosition = hidden ? float4(-2, -2, -2, 1) : clip;
        streams.GsTex = float2(streams.GsOffsetTex.zw) / GsTexSize;
        streams.GsData = float3(1, size, opacity);   // gamma scale 1: not pitched with the map
        streams.GsFill = float4(ToLinear(streams.GsColorIn.rgb) * streams.GsColorIn.a, streams.GsColorIn.a);
    }

    stage override void PSMain()
    {
        float EDGE_GAMMA = 0.105 / GsDevicePixelRatio;
        float gammaScale = streams.GsData.x, size = streams.GsData.y, opacity = streams.GsData.z;
        // both samples, then one chosen: no texture sampling under a branch
        float4 linearSample = GsAtlas.Sample(GsSampler, streams.GsTex);
        float4 pointSample = GsAtlas.Sample(GsPointSampler, streams.GsTex);
        float4 sampled = GsNearest > 0.5 ? pointSample : linearSample;
        if (GsIconMode > 0.5 && GsIconMode < 1.5)
        {
            // symbol_icon.fragment.glsl: texture * v_total_opacity, premultiplied sRGB; linear in vvvv
            float4 icon = sampled;
            if (GsLinearize > 0.5 && icon.a > 0) icon = float4(ToLinear(icon.rgb / icon.a) * icon.a, icon.a);
            streams.ColorTarget = icon * opacity;
        }
        else
            streams.ColorTarget = Sdf(sampled, size, opacity, gammaScale, EDGE_GAMMA);
    }

    // symbol_sdf.fragment.glsl, for text and SDF icons
    float4 Sdf(float4 sampled, float size, float opacity, float gammaScale, float EDGE_GAMMA)
    {
        float fontScale = GsIconMode > 0.5 ? size : size / 24.0;
        float gamma = EDGE_GAMMA / fontScale;
        float innerEdge = (256.0 - 64.0) / 256.0;
        float dist = GsIconMode > 0.5 ? sampled.a : sampled.r;
        float4 fill = streams.GsFill * GsColor;
        float4 text = 0, halo = 0;
        if (GsIsPlain > 0.5)
        {
            float gammaScaled = gamma * gammaScale;
            float alpha = smoothstep(innerEdge - gammaScaled, innerEdge + gammaScaled, dist);
            text = opacity * alpha * fill;
        }
        if (GsIsHalo > 0.5)
        {
            float gammaHalo = (GsHaloBlur * 1.19 / 8.0 + EDGE_GAMMA) / fontScale;
            float innerEdgeHalo = innerEdge + gammaHalo * gammaScale;
            float gammaScaledHalo = gammaHalo * gammaScale;
            float alphaHalo = smoothstep(innerEdgeHalo - gammaScaledHalo, innerEdgeHalo + gammaScaledHalo, dist);
            // the inside of the halo is empty too, in case the fill is transparent
            float haloEdge = (6.0 - GsHaloWidth / fontScale) / 8.0;
            alphaHalo = min(smoothstep(haloEdge - gammaScaledHalo, haloEdge + gammaScaledHalo, dist), 1.0 - alphaHalo);
            halo = opacity * alphaHalo * GsHaloColor;
        }
        if (GsIsPlain > 0.5 && GsIsHalo > 0.5) return text + (1 - text.a) * halo;
        if (GsIsHalo > 0.5) return halo;
        return text;
    }
};
